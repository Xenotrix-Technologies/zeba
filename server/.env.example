# ZEBA Environment Configuration Example

# Server Port & Environment
PORT=5000
NODE_ENV=production

# PostgreSQL Database Connection String
# e.g., postgresql://username:password@localhost:5432/zeba or Supabase / Neon connection URL
DATABASE_URL=

# Admin Authentication Secret
JWT_SECRET=zeba_super_secret_jwt_key_2026_wellness
JWT_EXPIRES_IN=7d

# Default Superadmin Credentials
ADMIN_DEFAULT_EMAIL=admin@zeba.com
ADMIN_DEFAULT_PASSWORD=ZebaAdmin#2026!

# Razorpay API Credentials
RAZORPAY_KEY_ID=rzp_live_yourKeyHere
RAZORPAY_KEY_SECRET=yourSecretHere

# Business & Support Configuration
WHATSAPP_NUMBER=+919876543210
WHATSAPP_DISPLAY=+91 98765 43210
CONTACT_EMAIL=care@zeba.com
CONTACT_PHONE=+91 98765 43210
INSTAGRAM_URL=https://instagram.com/zeba.care
FACEBOOK_URL=https://facebook.com/zeba.care

# Shipping Thresholds (INR)
FREE_SHIPPING_THRESHOLD=499
STANDARD_SHIPPING_FEE=49
